{
  "apiKey": "test",
  "endpoint": "http://localhost:4000/cli/events",
  "events": [
    "astro_button_click",
    "astro_click",
    "astro_conditional_click",
    "astro_dynamic_resolved",
    "astro_frontmatter_view",
    "astro_interp_z",
    "astro_map_item_click",
    "astro_page_view",
    "astro_shorthand_event"
  ],
  "functionWrappers": [
    {
      "name": "trackFeature"
    }
  ],
  "plugins": [
    "@eventra_dev/cli-plugin-astro"
  ],
  "sync": {
    "include": [
      "**/*.{ts,tsx,js,jsx}"
    ],
    "exclude": [
      "node_modules",
      "dist",
      ".next",
      ".git"
    ]
  }
}
