{
  "apiKey": "test",
  "endpoint": "http://localhost:4000/cli/events",
  "events": [
    "svelte_await_catch_click",
    "svelte_await_pending_click",
    "svelte_await_then_click",
    "svelte_button_click",
    "svelte_click",
    "svelte_direct_click",
    "svelte_dynamic_attr_resolved",
    "svelte_each_click",
    "svelte_else_click",
    "svelte_elseif_click",
    "svelte_if_click",
    "svelte_inline_markup_click",
    "svelte_key_click",
    "svelte_page_view",
    "svelte_slot_default_click"
  ],
  "functionWrappers": [
    {
      "name": "trackFeature"
    }
  ],
  "plugins": [
    "@eventra_dev/cli-plugin-svelte"
  ],
  "sync": {
    "include": [
      "**/*.{ts,tsx,js,jsx}"
    ],
    "exclude": [
      "node_modules",
      "dist",
      ".next",
      ".git"
    ]
  }
}
