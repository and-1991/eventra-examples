{
  "apiKey": "test",
  "endpoint": "http://localhost:4000/cli/events",
  "events": [
    "vue_click",
    "vue_dynamic_resolved",
    "vue_external_script_click",
    "vue_external_template_click",
    "vue_for_click",
    "vue_if_click",
    "vue_mixed_script_click",
    "vue_mixed_template_click",
    "vue_multi_a",
    "vue_multi_b",
    "vue_page_view",
    "vue_secondary_click",
    "vue_slot_click"
  ],
  "functionWrappers": [
    {
      "name": "trackFeature"
    }
  ],
  "plugins": [
    "@eventra_dev/cli-plugin-vue"
  ],
  "sync": {
    "include": [
      "**/*.{ts,tsx,js,jsx}"
    ],
    "exclude": [
      "node_modules",
      "dist",
      ".next",
      ".git"
    ]
  }
}
